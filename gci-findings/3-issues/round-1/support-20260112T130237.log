    // Arrange and Act
    Resource actualBuildNormalResult =
        new FileResourceBuilder()
            .buildNormal(Paths.get(System.getProperty("java.io.tmpdir"), "test.txt").toUri());

    // Assert
    assertTrue(actualBuildNormalResult instanceof FileResource);
    assertTrue(((FileResource) actualBuildNormalResult).getAttributes().isEmpty());
    assertNull(((FileResource) actualBuildNormalResult).getConnectionDetail());
    String actualId = actualBuildNormalResult.getId();
    String expectedId =
        String.join(
            "", "file:", Paths.get(System.getProperty("java.io.tmpdir"), "test.txt").toString());
    assertEquals(expectedId, actualId);
    ParentResource parent = ((FileResource) actualBuildNormalResult).getParent();
    assertTrue(parent instanceof DirectoryResource);
    String actualId2 = parent.getId();
    String expectedId2 = String.join("", "file:", System.getProperty("java.io.tmpdir"));
    assertEquals(expectedId2, actualId2);
    ParentResource parent2 = ((DirectoryResource) parent).getParent();
    assertTrue(parent2 instanceof SystemResource);
    assertEquals("file:/", parent2.getId());
    assertNull(((FileResource) actualBuildNormalResult).getSerialisedFormat());
    assertNull(((FileResource) actualBuildNormalResult).getType());
  }
}

