import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertTrue;
import com.diffblue.cover.annotations.ManagedByDiffblue;
import com.diffblue.cover.annotations.MethodsUnderTest;
import java.net.URI;
import java.nio.file.Paths;
import org.junit.jupiter.api.Disabled;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import uk.gov.gchq.palisade.resource.ParentResource;
import uk.gov.gchq.palisade.resource.Resource;
import uk.gov.gchq.palisade.resource.impl.DirectoryResource;
import uk.gov.gchq.palisade.resource.impl.FileResource;
import uk.gov.gchq.palisade.resource.impl.SystemResource;

class AbstractResourceBuilderDiffblueTest {
  /**
   * Test {@link AbstractResourceBuilder#create(URI)} with {@code resourceUri}.
   *
   * <p>Method under test: {@link AbstractResourceBuilder#create(URI)}
   */
  @Test
  @DisplayName("Test create(URI) with 'resourceUri'")
  @Disabled("TODO: Complete this test")
  @Tag("ContributionFromDiffblue")
  @ManagedByDiffblue
  @MethodsUnderTest({"Resource AbstractResourceBuilder.create(URI)"})
  void testCreateWithResourceUri() {
    // TODO: Diffblue Cover was only able to create a partial test for this method:
    //   Diffblue AI was unable to find a test

    // Arrange and Act
    Resource actualCreateResult =
        AbstractResourceBuilder.create(
            Paths.get(System.getProperty("java.io.tmpdir"), "test.txt").toUri());

    // Assert
    assertTrue(actualCreateResult instanceof FileResource);
    assertTrue(((FileResource) actualCreateResult).getAttributes().isEmpty());
    assertNull(((FileResource) actualCreateResult).getConnectionDetail());
    String actualId = actualCreateResult.getId();
    String expectedId =
        String.join(
            "", "file:", Paths.get(System.getProperty("java.io.tmpdir"), "test.txt").toString());
    assertEquals(expectedId, actualId);
    ParentResource parent = ((FileResource) actualCreateResult).getParent();
    assertTrue(parent instanceof DirectoryResource);
    String actualId2 = parent.getId();
    String expectedId2 = String.join("", "file:", System.getProperty("java.io.tmpdir"));
    assertEquals(expectedId2, actualId2);
    ParentResource parent2 = ((DirectoryResource) parent).getParent();
    assertTrue(parent2 instanceof SystemResource);
    assertEquals("file:/", parent2.getId());
    assertNull(((FileResource) actualCreateResult).getSerialisedFormat());
    assertNull(((FileResource) actualCreateResult).getType());
  }
}

